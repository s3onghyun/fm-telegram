[Unit]
Description=fm-telegram Firstmate bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
# Optional, user-owned 0600 file populated by a secret manager with
# FM_TELEGRAM_BOT_TOKEN=... . It is deliberately not generated by the installer.
EnvironmentFile=-%h/.config/fm-telegram/runtime.env
ExecStart=/usr/bin/env python3 @APP_DIR@/fm_telegram.py run
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
