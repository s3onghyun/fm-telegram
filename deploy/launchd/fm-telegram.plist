<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by deploy/install.sh. Token lookup remains in the login Keychain. -->
<plist version="1.0"><dict>
  <key>Label</key><string>@LABEL@</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>Umask</key><integer>63</integer>
  <!-- Standard, not Background: voice transcription is work the owner is waiting for. -->
  <key>ProcessType</key><string>Standard</string>
  <!-- Run the interpreter directly: TCC attributes file access to this exact binary. -->
  <key>ProgramArguments</key><array>
    <string>@PYTHON@</string><string>@APP_DIR@/fm_telegram.py</string><string>run</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOG_DIR@/fm-telegram.log</string>
  <key>StandardErrorPath</key><string>@LOG_DIR@/fm-telegram.log</string>
</dict></plist>
